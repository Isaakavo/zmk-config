#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        /* Tri-layer: Lower + Raise = Config */
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* LAYER 0: BASE
         * Same layout on macOS and Omarchy: both use GUI+C/V/X to copy,
         * paste and cut, so the left thumb GUI serves either system.
         */
        default_layer {
            display-name = "Base";
// -----------------------------------------------------------------------------------------
// | TAB  |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  | BSPC |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | ESC  |
//                    | GUI | LWR | RET |   | SPC | RSE | ALT |
            bindings = <
                &kp TAB    &kp Q  &kp W  &kp E  &kp R  &kp T     &kp Y  &kp U  &kp I      &kp O    &kp P     &kp BSPC
                &kp LCTRL  &kp A  &kp S  &kp D  &kp F  &kp G     &kp H  &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
                &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B     &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                                  &kp LGUI &mo 1 &kp RET         &kp SPACE &mo 2 &kp RALT
            >;
        };

        /* LAYER 1: LOWER (numbers, navigation & media)
         * Backtick sits on the TAB position: Lower + Tab types `
         * Arrows are mirrored on both halves so they stay reachable
         * while the right hand is on the mouse.
         */
        lower_layer {
            display-name = "Lower";
// -----------------------------------------------------------------------------------------
// |  `   |  1  |  2  |  3  |  4  |  5  |   |  6   |  7   |  8   |  9   |  0   | BSPC |
// | CTRL | LFT | DWN |  UP | RGT | DEL |   | LFT  | DWN  |  UP  | RGT  |      |      |
// | SHFT | HOME| PGDN| PGUP| END |     |   | VOL- | VOL+ | MUTE | PREV | PLAY | NEXT |
//                    | GUI |     | RET |   | SPC  |      |      |
            bindings = <
                &kp GRAVE  &kp N1    &kp N2     &kp N3     &kp N4     &kp N5    &kp N6        &kp N7        &kp N8     &kp N9     &kp N0   &kp BSPC
                &kp LCTRL  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &kp DEL   &kp LEFT      &kp DOWN      &kp UP     &kp RIGHT  &trans   &trans
                &kp LSHFT  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &trans    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_MUTE &kp C_PREV &kp C_PP &kp C_NEXT
                                     &kp LGUI   &trans     &kp RET              &kp SPACE     &trans        &trans
            >;
        };

        /* LAYER 2: RAISE (symbols & function keys)
         * F1-F12 fill the left block exactly. This drops the CTRL/SHFT
         * duplicates that stock keeps here; both still live on the base layer.
         */
        raise_layer {
            display-name = "Raise";
// -----------------------------------------------------------------------------------------
// | TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
// | F1  | F2  | F3  | F4  | F5  | F6  |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | F7  | F8  | F9  | F10 | F11 | F12 |   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                   | GUI |     | RET |   | SPC |     | ALT |
            bindings = <
                &kp TAB  &kp EXCL &kp AT   &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
                &kp F1   &kp F2   &kp F3   &kp F4   &kp F5   &kp F6      &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &kp GRAVE
                &kp F7   &kp F8   &kp F9   &kp F10  &kp F11  &kp F12     &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE &kp TILDE
                                  &kp LGUI &trans   &kp RET              &kp SPACE &trans    &trans
            >;
        };

        /* LAYER 3: CONFIG (Lower + Raise held together)
         * Bluetooth on top, profile cycling and system on the rows below.
         * The right half is intentionally empty: media moved to Lower,
         * where it is reachable with a single thumb.
         */
        config_layer {
            display-name = "Config";
// -----------------------------------------------------------------------------------------
// | BTCLR | BT0  | BT1  | BT2  | BT3  | BT4  |   |  |  |  |  |      |      |
// | BTPRV | BTNXT|      |      |      |      |   |  |  |  |  |      |      |
// | BOOT  | RESET|      |      |      | OUT  |   |  |  |  |  |RESET | BOOT |
//                       |      |      |      |   |  |  |  |
            bindings = <
                &bt BT_CLR       &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4     &trans &trans &trans &trans &trans      &trans
                &bt BT_PRV       &bt BT_NXT       &trans           &trans           &trans           &trans           &trans &trans &trans &trans &trans      &trans
                &bootloader      &sys_reset       &trans           &trans           &trans           &out OUT_TOG     &trans &trans &trans &trans &sys_reset  &bootloader
                                                  &trans           &trans           &trans                            &trans &trans &trans
            >;
        };
    };
};
